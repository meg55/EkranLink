<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Bağlıyken arka planda da çalışan hizmet (Android 9+ / 14+ ön plan hizmeti izinleri) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Holo.NoActionBar.Fullscreen">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|navigation"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="user">
            <!-- Pencere cihazla birlikte döner; dikey pencerede görüntü çevrilir (MainActivity.onWindowShape).
                 Android 6.0 öncesinde çözücü çeviremez: orada MainActivity yatay kilitler. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Bağlantıyı tutar: uygulama arka plana alınınca da PC'deki monitör kopmaz -->
        <service
            android:name=".EkranService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- PC (adb) "ekran olur musun?" diye sorar; tabletin "otomatik aç" ayarına göre cevap verir.
             DUMP: adb kabuğunda var, sıradan uygulamalar alamaz; başka uygulama kimliği okuyamaz, bekletmeyi değiştiremez -->
        <receiver
            android:name=".AutoStartReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
