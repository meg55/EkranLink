<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Bağlıyken arka planda da çalışan hizmet (Android 9+ / 14+ ön plan hizmeti izinleri) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Holo.NoActionBar.Fullscreen">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|navigation"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape">
            <!-- Android 16+ büyük ekranlarda (600dp+) bu kilit yok sayılır: dikey pencerede görüntü çevrilir
                 (MainActivity.onWindowShape) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Bağlantıyı tutar: uygulama arka plana alınınca da PC'deki monitör kopmaz -->
        <service
            android:name=".EkranService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- PC (adb) "ekran olur musun?" diye sorar; tabletin "otomatik aç" ayarına göre cevap verir -->
        <receiver
            android:name=".AutoStartReceiver"
            android:exported="true" />
    </application>
</manifest>
